// =============================================================================
// CHART OF ACCOUNTS & DOUBLE ENTRY
// =============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id       String      @id @default(cuid())
  code     String // e.g. "1-1000"
  name     String // e.g. "Kas Operasional"
  type     AccountType
  isActive Boolean     @default(true)
  isSystem Boolean     @default(false) // system accounts cannot be deleted

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  journalLines JournalLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@map("accounts")
}

model JournalEntry {
  id          String          @id @default(cuid())
  code        String // e.g. "JE-2026-07-001"
  date        DateTime // transaction date
  description String
  reference   String? // link to source document (invoice ID, expense ID, etc.)
  refType     JournalRefType? // source type: INVOICE, EXPENSE, CAPITAL, PRODUCTION, etc.

  lines JournalLine[]

  createdById String
  createdAt   DateTime  @default(now())
  voidAt      DateTime?
  voidReason  String?

  createdBy User   @relation(fields: [createdById], references: [id])
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, refType, reference])
  @@index([tenantId, date])
  @@index([tenantId, refType])
  @@map("journal_entries")
}

model JournalLine {
  id     String @id @default(cuid())
  sideId Int    @default(0) // ordering within entry (0, 1, 2...)

  debit  Decimal @db.Decimal(16, 2)
  credit Decimal @db.Decimal(16, 2)

  journalEntryId String
  accountId      String

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Budget {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  periodMonth Int
  periodYear  Int
  category    String
  amount      Decimal @db.Decimal(16, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, periodYear, periodMonth, category])
  @@index([tenantId, periodYear, periodMonth])
  @@map("budgets")
}

// =============================================================================
// CONTRACT & CONTRACT PRICE (OEM / Private Label)
// =============================================================================

model Contract {
  id               String    @id @default(cuid())
  tenantId         String
  customerId       String
  contractNumber   String
  startDate        DateTime
  endDate          DateTime?
  terms            String?
  allowCredit      Boolean   @default(false)
  paymentTermsDays Int?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  prices   ContractPrice[]

  @@unique([tenantId, customerId, contractNumber])
  @@index([tenantId])
  @@index([customerId])
  @@map("contracts")
}

model ContractPrice {
  id           String   @id @default(cuid())
  contractId   String
  productId    String
  tierName     String
  minOrderQty  Decimal  @db.Decimal(12, 2)
  pricePerKg   Decimal? @db.Decimal(14, 2)
  pricePerUnit Decimal? @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  invoiceItems InvoiceItem[]

  @@unique([tenantId, contractId, productId, tierName, minOrderQty], map: "contract_prices_tenantId_contractId_productId_tierName_minOrder")
  @@index([contractId])
  @@index([productId])
  @@index([tenantId])
  @@map("contract_prices")
}

// =============================================================================
// CUPPING MODULE — SCA Cupping Protocol Scoring
// =============================================================================

enum CuppingCategory {
  FRAGRANCE
  AROMA
  FLAVOR
  AFTERTASTE
  ACIDITY
  BODY
  BALANCE
  UNIFORMITY
  CLEAN_CUP
  SWEETNESS
  OVERALL
}

model CuppingSession {
  id            String   @id @default(cuid())
  code          String
  tenantId      String
  batchId       String?
  productId     String?
  lotId         String? // traceability: lot green bean yang dievaluasi
  date          DateTime
  location      String?
  evaluatorName String?
  notes         String?
  defectCount   Int? // jumlah taint/fault (konvensi SCA, penalti 2 poin/defect)
  totalScore    Float? // komposit SCA 0–100 (dihitung server saat simpan)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch   ParentRoastingBatch? @relation(fields: [batchId], references: [id])
  product Product?             @relation(fields: [productId], references: [id])
  lot     Lot?                 @relation(fields: [lotId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  scores  CuppingScore[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([batchId])
  @@index([productId])
  @@index([lotId])
  @@index([tenantId, date])
  @@map("cupping_sessions")
}

model CuppingScore {
  id        String          @id @default(cuid())
  sessionId String
  category  CuppingCategory
  score     Decimal         @db.Decimal(4, 2)
  maxScore  Decimal         @default(10) @db.Decimal(4, 2)
  notes     String?

  session CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, category])
  @@index([sessionId])
  @@index([category])
  @@map("cupping_scores")
}

// =============================================================================
// TABLE S1 · Warehouse (Gudang)  — SMART STORAGE EPIC
// Physical storage facility. Tenant-scoped. One tenant may have multiple
// warehouses; the lazily-created default is flagged isDefault=true.
// =============================================================================

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  code      String // e.g. "WH-01"
  name      String // e.g. "Gudang Utama"
  address   String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId, isDefault])
  @@map("warehouses")
}

// =============================================================================
// TABLE S2 · Location (Lokasi / Rak / Bin)  — SMART STORAGE EPIC
// Granular storage position within a warehouse (e.g. shelf/rack/bin).
// Tenant-scoped; inherits warehouse isolation via FK cascade.
// =============================================================================

model Location {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  code        String // e.g. "A-01-02" (zone-row-bin)
  name        String // e.g. "Rak A, Anrak, Bin 02"
  zone        String? // optional grouping e.g. "DRY", "COLD"
  capacity    Decimal? @db.Decimal(12, 3) // kapasitas kapasitas (satuan bebas, opsional)

  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false)
  systemPurpose String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse                 Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  placements                LotPlacement[]
  outTransfers              LocationTransfer[]         @relation("SourceLocation")
  inTransfers               LocationTransfer[]         @relation("DestinationLocation")
  opnames                   LocationOpname[]
  roastMaterialReservations RoastMaterialReservation[]

  @@unique([tenantId, warehouseId, code])
  @@index([tenantId, warehouseId, isDefault])
  @@map("locations")
}

// =============================================================================
// TABLE S3 · LotPlacement  — SMART STORAGE EPIC
// Records how much of a canonical Lot is physically positioned in a Location.
// Sum of quantityKg across placements for a lot MUST NOT exceed the lot's
// remaining (ledger-adjusted) balance. Historical lots without placement
// remain "Belum Ditempatkan".
// =============================================================================

model LotPlacement {
  id           String  @id @default(cuid())
  tenantId     String
  lotId        String
  locationId   String
  quantityKg   Decimal @db.Decimal(12, 3) // berat yang ditempatkan di lokasi ini
  quantityUnit Int     @default(0) // unit yang ditempatkan (FG / packaging)
  supplyQty    Decimal @default(0) @db.Decimal(12, 3) // supply baseUnit yang ditempatkan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot      Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, lotId, locationId])
  @@index([tenantId, locationId])
  @@index([tenantId, lotId])
  @@map("lot_placements")
}

// =============================================================================
// TABLE S4 · LocationTransfer  — SMART STORAGE EPIC
// Atomic movement of quantity from one location to another for a given lot.
// Each transfer adjusts two LotPlacements within a single transaction:
// source decremented, destination incremented. The source placement must
// hold enough quantity to cover the transfer amount.
// =============================================================================

enum LocationTransferStatus {
  PENDING // dalam proses
  COMPLETED // selesai
  VOID // dibatalkan
}

model LocationTransfer {
  id                    String   @id @default(cuid())
  tenantId              String
  lotId                 String
  sourceLocationId      String
  destinationLocationId String
  quantityKg            Decimal? @db.Decimal(12, 3) // kg yang dipindah (jika product tracked by kg)
  quantityUnit          Int? // unit yang dipindah (jika product tracked by unit)
  supplyQty             Decimal? @db.Decimal(12, 3) // supply qty yang dipindah

  notes       String?
  status      LocationTransferStatus @default(PENDING)
  completedAt DateTime?
  voidAt      DateTime?
  voidReason  String?

  createdAt   DateTime @default(now())
  createdById String
  updatedAt   DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot                 Lot      @relation(fields: [lotId], references: [id])
  sourceLocation      Location @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation Location @relation("DestinationLocation", fields: [destinationLocationId], references: [id])
  createdBy           User     @relation(fields: [createdById], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, lotId])
  @@index([tenantId, sourceLocationId])
  @@index([tenantId, destinationLocationId])
  @@map("location_transfers")
}

// =============================================================================
// TABLE S5 · LocationOpname  — SMART STORAGE EPIC
// Physical count (opname) of a lot at a specific location. Draft → Confirmed.
// On confirm, the LotPlacement quantity is set to the counted value and any
// variance is reconciled in the canonical InventoryLedger.
// =============================================================================

enum LocationOpnameStatus {
  DRAFT // sedang disiapkan, belum disahkan
  CONFIRMED // sudah disahkan — stok telah disesuaikan
  CANCELLED // dibatalkan
}

model LocationOpname {
  id         String @id @default(cuid())
  tenantId   String
  locationId String
  lotId      String

  // System-quantity captured at draft time (from existing placement or lot).
  systemQuantityKg   Decimal? @db.Decimal(12, 3)
  systemQuantityUnit Int?
  systemSupplyQty    Decimal? @db.Decimal(12, 3)

  // Physically counted quantity.
  countedQuantityKg   Decimal? @db.Decimal(12, 3)
  countedQuantityUnit Int?
  countedSupplyQty    Decimal? @db.Decimal(12, 3)

  notes         String?
  status        LocationOpnameStatus @default(DRAFT)
  confirmedAt   DateTime?
  confirmedById String?
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])
  confirmedBy User?    @relation("OpnameConfirmedBy", fields: [confirmedById], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@index([tenantId, lotId])
  @@map("location_opnames")
}
