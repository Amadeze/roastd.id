// =============================================================================
// TABLE · PurchaseOrder (PO Lite)
// Purchase Order sederhana yang terintegrasi dengan Reorder Point Alert.
// =============================================================================

enum POStatus {
  DRAFT // Belum dikirim
  SENT // Sudah dikirim ke supplier
  PARTIAL // Sebagian barang diterima
  RECEIVED // Semua barang diterima
  CANCELLED // Dibatalkan
}

model PurchaseOrder {
  id     String   @id @default(cuid())
  code   String // PO-YYYYMM-NNN
  status POStatus @default(DRAFT)

  // Supplier
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Snapshot data saat PO dibuat
  expectedDate DateTime? // Tanggal perkiraan barang datang
  notes        String?

  // Financial
  estimatedShippingCost Decimal  @default(0) @db.Decimal(12, 2) // Estimasi ongkir saat PO dibuat
  totalEstimate         Decimal? @db.Decimal(12, 2) // Item + estimasi ongkir

  // Tracking
  sentAt     DateTime? // Kapan PO dikirim ke supplier
  receivedAt DateTime? // Kapan barang diterima

  // Audit
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Relations
  items     PurchaseOrderItem[]
  purchases Purchase[] // Link ke Purchase saat barang datang (bisa multi untuk partial receipt)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // Produk
  productId    String?
  product      Product?             @relation(fields: [productId], references: [id])
  packagingId  String?
  packaging    Packaging?           @relation(fields: [packagingId], references: [id])
  supplyItemId String?
  supplyItem   InventorySupplyItem? @relation(fields: [supplyItemId], references: [id])

  // Quantity & Harga
  quantity       Decimal  @db.Decimal(10, 3) // kg atau unit
  unitPrice      Decimal  @db.Decimal(12, 2) // Harga per kg/unit
  totalPrice     Decimal  @db.Decimal(12, 2) // quantity × unitPrice
  supplyQuantity Decimal? @db.Decimal(12, 3) // SUPPLY: kuantitas (baseUnit item, pecahan)

  // Reorder reference (dari mana data ini)
  reorderPoint Decimal? @db.Decimal(10, 3) // Snapshot reorder point saat PO dibuat
  currentStock Decimal? @db.Decimal(10, 3) // Snapshot stok saat PO dibuat

  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

