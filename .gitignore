# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/output

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Husky 9 regenerates this dir on install; only the hooks are source
/.husky/_/

# Runtime local-storage upload fallback (user content, never source)
/public/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/server-fork-smoke*.log
*.log
*.diff
dump*.sql
scratch/
AUDIT_REPORT.md

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# local private object-storage fallback
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mimocode
.mimocode/
.ua/

# local AI/tool configuration
/.claude/
/.kilo/
/.mcp.json

# generated codebase graph (regenerable)
/graphify-out/

# Desktop release artifacts: keep only the current production installer.
/public/downloads/RoastdStudio-*.exe
!/public/downloads/RoastdStudio-0.10.2-x64-setup.exe
/public/downloads/ArtisanSync-*.exe

# Desktop app build output (Tauri/Electron renderer + main bundles)
/desktop/dist/
/desktop/src-tauri/target/

# Stray LLM/diagnostic scratch files (regenerable from external tooling)
/__dream_query.py
/.dream_query.py
/system_prompt.txt

# Pending merge from deleted roastd-main clone — human review required before commit
/tools/pending-merge-from-roastd-main/

# Local restore-drill artifacts. The encrypted dump + sha256 + catalogue are
# rotated by the daily backup workflow; only run.md (no plaintext) is allowed.
/docs/recovery-evidence/*/
!/docs/recovery-evidence/README.md

# pnpm store accidentally created inside repo (global store is elsewhere)
/.pnpm-store/

# Local tool / diagnostic caches
/.commandcode/
/.playwright-cli/

# Desktop release artifacts (installers, unpacked Electron, blockmaps)
# Keep only the current production installer in /public/downloads.
/desktop/release/

# Regenerable LLM/graphify scratch scripts (not application source)
chunk_files.py
run_*.py
graphify_step1.ps1
merge_and_build.py
