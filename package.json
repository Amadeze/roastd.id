{
  "name": "ros-app",
  "version": "0.1.9",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui:smoke": "node scripts/ui-smoke.cjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:release": "pnpm build && node scripts/run-release-e2e.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "audit:stock": "tsx --env-file-if-exists=.env.local scripts/audit-stock.mts",
    "audit:integrity": "tsx --env-file-if-exists=.env.local scripts/audit-data-integrity.mts",
    "audit:tenant-isolation": "tsx --env-file-if-exists=.env.local scripts/audit-tenant-isolation.mts",
    "repair:tenant-relations": "tsx --env-file-if-exists=.env.local scripts/repair-tenant-relations.mts",
    "repair:hpp-cache": "tsx --env-file-if-exists=.env.local scripts/repair-hpp-cache.mts",
    "repair:lot-ledger": "tsx --env-file-if-exists=.env.local scripts/repair-lot-ledger.mts",
    "repair:journals": "tsx --env-file-if-exists=.env.local scripts/repair-missing-journals.mts",
    "patch:supply-backfill": "tsx --env-file-if-exists=.env.local prisma/patches/006-backfill-inventory-supply-items.ts",
    "security:encrypt-credentials": "tsx --env-file-if-exists=.env.local scripts/encrypt-credentials.mts",
    "security:rotate-credential-key": "tsx --env-file-if-exists=.env.local scripts/rotate-credential-key.mts",
    "maintenance:cleanup": "tsx --env-file-if-exists=.env.local scripts/cleanup-operational-data.mts",
    "maintenance:subscriptions": "tsx --env-file-if-exists=.env.local scripts/sync-subscriptions.mts",
    "maintenance:overdue-reminders": "tsx --env-file-if-exists=.env.local scripts/send-overdue-reminders.mts",
    "check:notifications": "tsx --env-file-if-exists=.env.local scripts/check-notification-providers.mts",
    "preflight:production": "tsx --env-file-if-exists=.env.local scripts/production-preflight.mts",
    "preflight:backfill": "node scripts/migration-recovery/backfill-preflight.mjs",
    "prisma:migrate:dev": "node scripts/guard-prisma-target.mjs && prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/guard-prisma-target.mjs && prisma migrate deploy",
    "prisma:migrate:reset": "node scripts/guard-prisma-target.mjs && prisma migrate reset",
    "prisma:db:push": "node scripts/guard-prisma-target.mjs && prisma db push",
    "verify": "prisma validate && pnpm run typecheck && pnpm run lint -- --quiet && pnpm run test && pnpm run build",
    "seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet",
      "bash -c 'pnpm prisma format || true'"
    ],
    "*.{prisma}": [
      "bash -c 'pnpm prisma format || true'"
    ],
    "package.json": [
      "bash -c 'pnpm install --frozen-lockfile || true'"
    ]
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "css-tree": "^3.2.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "iron-session": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "midtrans-client": "^1.4.3",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@mohammednagy/graphify-ts": "^0.23.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/midtrans-client": "^1.4.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prisma": "^7.9.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
